# SandboxAgent configuration. Copy to .env (or export in your shell).
# Every value is optional — defaults are the local-Ollama setup.

# --- LLM backend -----------------------------------------------------------
# "ollama" = local Ollama (default). "cloud" = OpenAI-compatible free APIs
# (Groq, Gemini, NVIDIA) with automatic fallback chain.
SANDBOX_AGENT_LLM_PROVIDER=ollama

# --- Cloud fallback chain (only used when LLM_PROVIDER=cloud) --------------
# Providers tried in order. When one hits a rate limit (429), a server
# error (5xx) or a network failure, the next entry takes over automatically.
SANDBOX_AGENT_LLM_CHAIN="groq,gemini"

# One key per provider (or comma-separated keys: GROQ_API_KEYS="k1,k2" —
# extra keys are tried in order, so a rate-limited key fails over).
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# NVIDIA_API_KEY=nvapi-...

# Optional per-provider overrides (defaults shown):
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Seconds a rate-limited chain entry is skipped before retry.
# SANDBOX_AGENT_LLM_COOLDOWN=60

# --- Ollama (default backend) ------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# SANDBOX_AGENT_MODEL=qwen2.5:7b
